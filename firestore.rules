rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // L'account esiste ed è abilitato da un gestore (documento in "utenti")
    function profilo() { return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data; }
    function attivo()  { return request.auth != null
                          && exists(/databases/$(database)/documents/utenti/$(request.auth.uid))
                          && profilo().attivo == true; }
    function gestore() { return attivo() && profilo().ruolo == 'gestore'; }

    // Account: ognuno legge solo il proprio profilo; i gestori leggono e gestiscono tutti
    match /utenti/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow get, list: if gestore();
      allow create, update, delete: if gestore();
    }

    // Personaggi: i genitori solo i propri (campo owner), i gestori tutti
    match /personaggi/{id} {
      allow read: if gestore() || (attivo() && resource.data.owner == request.auth.uid);
      allow create: if gestore() || (attivo() && request.resource.data.owner == request.auth.uid);
      allow update: if gestore() || (attivo() && resource.data.owner == request.auth.uid
                                              && request.resource.data.owner == request.auth.uid);
      allow delete: if gestore() || (attivo() && resource.data.owner == request.auth.uid);
    }

    // Tutto il resto è vietato
    match /{altro=**} { allow read, write: if false; }
  }
}
